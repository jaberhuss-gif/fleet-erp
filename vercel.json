{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/health", "dest": "/server/server.js" },
    { "src": "/api/(.*)", "dest": "/server/server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/client/dist/$1" },
    { "src": "/", "dest": "/client/dist/index.html" }
  ]
}
