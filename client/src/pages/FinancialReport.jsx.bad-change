import { useState, useEffect } from 'react';
import api from '../api/client';
import { printContent } from '../api/print';

export default function FinancialReport() {
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  useEffect(() => {
    load();
  }, []);

  const load = async () => {
    try {
      setLoading(true);
      const res = await api.get('/reports/financial');
      setData(res.data);
    } catch (e) {
      setError(e.message);
    } finally {
      setLoading(false);
    }
  };

  if (loading) {
    return <div className="loading">Loading financial report...</div>;
  }

  if (error) {
    return <div className="alert alert-error">{error}</div>;
  }

  if (!data) {
    return <div className="loading">No data</div>;
  }

  // ============================================================
  // FINANCIAL REPORT RULES
  // ============================================================

  const MAINTENANCE_BASELINE = 20577;
  const DEVELOPMENT_BASELINE = 132551;

  const MAINTENANCE_SALARY = 2200;
  const DEVELOPMENT_SALARY = 2200;

  const TOTAL_SALARY =
    MAINTENANCE_SALARY + DEVELOPMENT_SALARY;

  const TOTAL_MONTHLY_BASELINE =
    MAINTENANCE_BASELINE + DEVELOPMENT_BASELINE;

  // Actual months returned by the report
  const months = Array.isArray(data.months)
    ? data.months
    : [];

  const monthCount = months.length;

  // ============================================================
  // NORMALIZE MONTH DATA
  // ============================================================

  const monthlyData = months.map((m) => {
    const contractorWO = Number(m.contractorWO || 0);
    const partsWO = Number(m.partsWO || 0);

    const contractorDev = Number(m.contractorDev || 0);
    const partsDev = Number(m.partsDev || 0);

    // Fixed salaries according to the financial rule
    const maintenanceSalary = MAINTENANCE_SALARY;
    const developmentSalary = DEVELOPMENT_SALARY;

    // ------------------------------------------------------------
    // MAINTENANCE
    // ------------------------------------------------------------

    const maintActual =
      contractorWO +
      partsWO +
      maintenanceSalary;

    const maintSavings =
      MAINTENANCE_BASELINE -
      maintActual;

    const maintPct =
      MAINTENANCE_BASELINE !== 0
        ? (maintSavings / MAINTENANCE_BASELINE) * 100
        : 0;

    // ------------------------------------------------------------
    // DEVELOPMENT
    // ------------------------------------------------------------

    const devActual =
      contractorDev +
      partsDev +
      developmentSalary;

    const devSavings =
      DEVELOPMENT_BASELINE -
      devActual;

    const devPct =
      DEVELOPMENT_BASELINE !== 0
        ? (devSavings / DEVELOPMENT_BASELINE) * 100
        : 0;

    // ------------------------------------------------------------
    // TOTAL
    // ------------------------------------------------------------

    const totalBaseline =
      MAINTENANCE_BASELINE +
      DEVELOPMENT_BASELINE;

    const totalActual =
      maintActual +
      devActual;

    const totalSavings =
      maintSavings +
      devSavings;

    const totalSavingsPct =
      totalBaseline !== 0
        ? (totalSavings / totalBaseline) * 100
        : 0;

    return {
      ...m,

      contractorWO,
      partsWO,
      contractorDev,
      partsDev,

      maintenanceSalary,
      developmentSalary,

      maintActual,
      maintSavings,
      maintPct,

      devActual,
      devSavings,
      devPct,

      totalBaseline,
      totalActual,
      totalSavings,
      totalSavingsPct,
    };
  });

  // ============================================================
  // GRAND TOTALS
  // ============================================================

  const maintenanceBaselineTotal =
    MAINTENANCE_BASELINE * monthCount;

  const developmentBaselineTotal =
    DEVELOPMENT_BASELINE * monthCount;

  const totalBaseline =
    maintenanceBaselineTotal +
    developmentBaselineTotal;

  const contractorWOTotal = monthlyData.reduce(
    (sum, m) => sum + m.contractorWO,
    0
  );

  const partsWOTotal = monthlyData.reduce(
    (sum, m) => sum + m.partsWO,
    0
  );

  const contractorDevTotal = monthlyData.reduce(
    (sum, m) => sum + m.contractorDev,
    0
  );

  const partsDevTotal = monthlyData.reduce(
    (sum, m) => sum + m.partsDev,
    0
  );

  const maintenanceSalaryTotal =
    MAINTENANCE_SALARY * monthCount;

  const developmentSalaryTotal =
    DEVELOPMENT_SALARY * monthCount;

  const totalSalary =
    maintenanceSalaryTotal +
    developmentSalaryTotal;

  const maintActualTotal =
    contractorWOTotal +
    partsWOTotal +
    maintenanceSalaryTotal;

  const devActualTotal =
    contractorDevTotal +
    partsDevTotal +
    developmentSalaryTotal;

  const totalActual =
    maintActualTotal +
    devActualTotal;

  const maintSavingsTotal =
    maintenanceBaselineTotal -
    maintActualTotal;

  const devSavingsTotal =
    developmentBaselineTotal -
    devActualTotal;

  const totalSavings =
    maintSavingsTotal +
    devSavingsTotal;

  const maintSavingsPct =
    maintenanceBaselineTotal !== 0
      ? (maintSavingsTotal / maintenanceBaselineTotal) * 100
      : 0;

  const devSavingsPct =
    developmentBaselineTotal !== 0
      ? (devSavingsTotal / developmentBaselineTotal) * 100
      : 0;

  const totalSavingsPct =
    totalBaseline !== 0
      ? (totalSavings / totalBaseline) * 100
      : 0;

  // ============================================================
  // PERCENTAGE STYLE
  // ============================================================

  const getPctStyle = (pct) => {
    if (pct >= 70) {
      return {
        bg: '#dcfce7',
        color: '#16a34a',
        icon: '🟢',
      };
    }

    if (pct >= 40) {
      return {
        bg: '#fef3c7',
        color: '#b45309',
        icon: '🟡',
      };
    }

    if (pct >= 0) {
      return {
        bg: '#fee2e2',
        color: '#dc2626',
        icon: '🔴',
      };
    }

    return {
      bg: '#991b1b',
      color: 'white',
      icon: '⚠️',
    };
  };

  const maintStyle = getPctStyle(maintSavingsPct);
  const devStyle = getPctStyle(devSavingsPct);
  const totalStyle = getPctStyle(totalSavingsPct);

  // ============================================================
  // RENDER
  // ============================================================

  return (
    <div>

      {/* HEADER */}
      <div
        style={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          marginBottom: '16px',
          flexWrap: 'wrap',
          gap: '10px',
        }}
      >
        <div>
          <h2 style={{ margin: 0 }}>
            💰 Financial Report
          </h2>

          <p
            style={{
              color: '#64748b',
              fontSize: '13px',
              marginTop: '4px',
            }}
          >
            Baseline vs Actual — Maintenance & Development
          </p>
        </div>

        <button
          className="print-btn no-print"
          onClick={() =>
            printContent(
              'Financial Report',
              'Baseline vs Actual'
            )
          }
        >
          🖨️ Print Report
        </button>
      </div>

      {/* ======================================================
          GRAND SUMMARY
      ======================================================= */}

      <div
        className="cards-grid"
        style={{ marginBottom: '24px' }}
      >

        <div
          className="card"
          style={{
            borderLeft: '5px solid #1e3a8a',
          }}
        >
          <h3>Total Baseline</h3>

          <div
            className="big-number"
            style={{ color: '#1e3a8a' }}
          >
            {totalBaseline.toLocaleString()}
          </div>

          <div className="sub">
            SAR — {monthCount} month{monthCount !== 1 ? 's' : ''}
          </div>
        </div>

        <div
          className="card warning"
          style={{
            borderLeft: '5px solid #f59e0b',
          }}
        >
          <h3>Total Actual</h3>

          <div
            className="big-number"
            style={{ color: '#f59e0b' }}
          >
            {totalActual.toLocaleString()}
          </div>

          <div className="sub">
            SAR — All costs
          </div>
        </div>

        <div
          className="card success"
          style={{
            borderLeft: '5px solid #16a34a',
          }}
        >
          <h3>Total Savings</h3>

          <div
            className="big-number"
            style={{ color: '#16a34a' }}
          >
            {totalSavings.toLocaleString()}
          </div>

          <div className="sub">
            {totalSavingsPct.toFixed(1)}% saved
          </div>
        </div>
      </div>

      {/* ======================================================
          MAINTENANCE
      ======================================================= */}

      <div
        className="panel"
        style={{
          borderTop: '5px solid #1e3a8a',
          marginBottom: '20px',
        }}
      >
        <h2
          style={{
            color: '#1e3a8a',
            marginTop: 0,
          }}
        >
          🔧 General Maintenance
        </h2>

        <div
          className="cards-grid"
          style={{ marginBottom: '16px' }}
        >

          <div className="card">
            <h3>Baseline / Month</h3>

            <div
              className="big-number"
              style={{
                color: '#1e3a8a',
                fontSize: '22px',
              }}
            >
              {MAINTENANCE_BASELINE.toLocaleString()}
            </div>

            <div className="sub">
              SAR / month
            </div>
          </div>

          <div className="card">
            <h3>Salary / Month</h3>

            <div
              className="big-number"
              style={{
                color: '#64748b',
                fontSize: '22px',
              }}
            >
              {MAINTENANCE_SALARY.toLocaleString()}
            </div>

            <div className="sub">
              SAR / month
            </div>
          </div>

          <div className="card success">
            <h3>Total Savings</h3>

            <div
              className="big-number"
              style={{
                color: '#16a34a',
                fontSize: '22px',
              }}
            >
              {maintSavingsTotal.toLocaleString()}
            </div>

            <div className="sub">
              {maintSavingsPct.toFixed(1)}%
            </div>
          </div>

          <div className="card">
            <h3>Baseline × Months</h3>

            <div
              className="big-number"
              style={{
                color: '#64748b',
                fontSize: '22px',
              }}
            >
              {maintenanceBaselineTotal.toLocaleString()}
            </div>

            <div className="sub">
              {monthCount} months
            </div>
          </div>
        </div>

        <table>
          <thead>
            <tr style={{ background: '#eff6ff' }}>
              <th>Month</th>
              <th>Baseline</th>
              <th>WO</th>
              <th>Parts</th>
              <th>Salary</th>
              <th style={{ color: '#dc2626' }}>
                Actual
              </th>
              <th style={{ color: '#16a34a' }}>
                Savings
              </th>
              <th>%</th>
            </tr>
          </thead>

          <tbody>
            {monthlyData.map((m) => {
              const s = getPctStyle(m.maintPct);

              return (
                <tr key={'m-' + m.month}>

                  <td style={{ fontWeight: 'bold' }}>
                    {m.month}
                  </td>

                  <td>
                    {MAINTENANCE_BASELINE.toLocaleString()}
                  </td>

                  <td>
                    {m.contractorWO.toLocaleString()}
                  </td>

                  <td>
                    {m.partsWO.toLocaleString()}
                  </td>

                  <td>
                    {MAINTENANCE_SALARY.toLocaleString()}
                  </td>

                  <td
                    style={{
                      fontWeight: 'bold',
                      color: '#dc2626',
                    }}
                  >
                    {m.maintActual.toLocaleString()}
                  </td>

                  <td
                    style={{
                      fontWeight: 'bold',
                      color: '#16a34a',
                    }}
                  >
                    {m.maintSavings.toLocaleString()}
                  </td>

                  <td>
                    <span
                      className="status-badge"
                      style={{
                        background: s.bg,
                        color: s.color,
                        fontWeight: 'bold',
                      }}
                    >
                      {s.icon} {m.maintPct.toFixed(1)}%
                    </span>
                  </td>

                </tr>
              );
            })}

            <tr
              style={{
                background: '#dbeafe',
                fontWeight: 'bold',
              }}
            >
              <td>TOTAL</td>

              <td>
                {maintenanceBaselineTotal.toLocaleString()}
              </td>

              <td>
                {contractorWOTotal.toLocaleString()}
              </td>

              <td>
                {partsWOTotal.toLocaleString()}
              </td>

              <td>
                {maintenanceSalaryTotal.toLocaleString()}
              </td>

              <td style={{ color: '#dc2626' }}>
                {maintActualTotal.toLocaleString()}
              </td>

              <td style={{ color: '#16a34a' }}>
                {maintSavingsTotal.toLocaleString()}
              </td>

              <td>
                <span
                  className="status-badge"
                  style={{
                    background: maintStyle.bg,
                    color: maintStyle.color,
                    fontWeight: 'bold',
                  }}
                >
                  {maintStyle.icon}{' '}
                  {maintSavingsPct.toFixed(1)}%
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      {/* ======================================================
          DEVELOPMENT
      ======================================================= */}

      <div
        className="panel"
        style={{
          borderTop: '5px solid #16a34a',
          marginBottom: '20px',
        }}
      >
        <h2
          style={{
            color: '#16a34a',
            marginTop: 0,
          }}
        >
          📁 Development Projects
        </h2>

        <div
          className="cards-grid"
          style={{ marginBottom: '16px' }}
        >

          <div className="card">
            <h3>Baseline / Month</h3>

            <div
              className="big-number"
              style={{
                color: '#16a34a',
                fontSize: '22px',
              }}
            >
              {DEVELOPMENT_BASELINE.toLocaleString()}
            </div>

            <div className="sub">
              SAR / month
            </div>
          </div>

          <div className="card">
            <h3>Salary / Month</h3>

            <div
              className="big-number"
              style={{
                color: '#64748b',
                fontSize: '22px',
              }}
            >
              {DEVELOPMENT_SALARY.toLocaleString()}
            </div>

            <div className="sub">
              SAR / month
            </div>
          </div>

          <div className="card success">
            <h3>Total Savings</h3>

            <div
              className="big-number"
              style={{
                color: '#16a34a',
                fontSize: '22px',
              }}
            >
              {devSavingsTotal.toLocaleString()}
            </div>

            <div className="sub">
              {devSavingsPct.toFixed(1)}%
            </div>
          </div>

          <div className="card">
            <h3>Baseline × Months</h3>

            <div
              className="big-number"
              style={{
                color: '#64748b',
                fontSize: '22px',
              }}
            >
              {developmentBaselineTotal.toLocaleString()}
            </div>

            <div className="sub">
              {monthCount} months
            </div>
          </div>
        </div>

        <table>
          <thead>
            <tr style={{ background: '#f0fdf4' }}>
              <th>Month</th>
              <th>Baseline</th>
              <th>Dev</th>
              <th>Parts</th>
              <th>Salary</th>
              <th style={{ color: '#dc2626' }}>
                Actual
              </th>
              <th style={{ color: '#16a34a' }}>
                Savings
              </th>
              <th>%</th>
            </tr>
          </thead>

          <tbody>
            {monthlyData.map((m) => {
              const s = getPctStyle(m.devPct);

              return (
                <tr key={'d-' + m.month}>

                  <td style={{ fontWeight: 'bold' }}>
                    {m.month}
                  </td>

                  <td>
                    {DEVELOPMENT_BASELINE.toLocaleString()}
                  </td>

                  <td>
                    {m.contractorDev.toLocaleString()}
                  </td>

                  <td>
                    {m.partsDev.toLocaleString()}
                  </td>

                  <td>
                    {DEVELOPMENT_SALARY.toLocaleString()}
                  </td>

                  <td
                    style={{
                      fontWeight: 'bold',
                      color: '#dc2626',
                    }}
                  >
                    {m.devActual.toLocaleString()}
                  </td>

                  <td
                    style={{
                      fontWeight: 'bold',
                      color: '#16a34a',
                    }}
                  >
                    {m.devSavings.toLocaleString()}
                  </td>

                  <td>
                    <span
                      className="status-badge"
                      style={{
                        background: s.bg,
                        color: s.color,
                        fontWeight: 'bold',
                      }}
                    >
                      {s.icon} {m.devPct.toFixed(1)}%
                    </span>
                  </td>

                </tr>
              );
            })}

            <tr
              style={{
                background: '#dcfce7',
                fontWeight: 'bold',
              }}
            >
              <td>TOTAL</td>

              <td>
                {developmentBaselineTotal.toLocaleString()}
              </td>

              <td>
                {contractorDevTotal.toLocaleString()}
              </td>

              <td>
                {partsDevTotal.toLocaleString()}
              </td>

              <td>
                {developmentSalaryTotal.toLocaleString()}
              </td>

              <td style={{ color: '#dc2626' }}>
                {devActualTotal.toLocaleString()}
              </td>

              <td style={{ color: '#16a34a' }}>
                {devSavingsTotal.toLocaleString()}
              </td>

              <td>
                <span
                  className="status-badge"
                  style={{
                    background: devStyle.bg,
                    color: devStyle.color,
                    fontWeight: 'bold',
                  }}
                >
                  {devStyle.icon}{' '}
                  {devSavingsPct.toFixed(1)}%
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      {/* ======================================================
          GRAND TOTAL
      ======================================================= */}

      <div
        className="panel"
        style={{
          borderTop: '5px solid #8b5cf6',
          background:
            'linear-gradient(135deg, #faf5ff 0%, #ffffff 100%)',
        }}
      >
        <h2
          style={{
            color: '#8b5cf6',
            marginTop: 0,
          }}
        >
          💰 Grand Total — Everything Combined
        </h2>

        <table>
          <thead>
            <tr style={{ background: '#faf5ff' }}>
              <th>Month</th>
              <th>Baseline (Maint + Dev)</th>
              <th>Actual (All Costs)</th>
              <th style={{ color: '#16a34a' }}>
                Savings
              </th>
              <th>Savings %</th>
            </tr>
          </thead>

          <tbody>
            {monthlyData.map((m) => {
              const s = getPctStyle(
                m.totalSavingsPct
              );

              return (
                <tr key={'g-' + m.month}>

                  <td style={{ fontWeight: 'bold' }}>
                    {m.month}
                  </td>

                  <td>
                    {m.totalBaseline.toLocaleString()}
                  </td>

                  <td>
                    {m.totalActual.toLocaleString()}
                  </td>

                  <td
                    style={{
                      fontWeight: 'bold',
                      color: '#16a34a',
                    }}
                  >
                    {m.totalSavings.toLocaleString()}
                  </td>

                  <td>
                    <span
                      className="status-badge"
                      style={{
                        background: s.bg,
                        color: s.color,
                        fontWeight: 'bold',
                      }}
                    >
                      {s.icon}{' '}
                      {m.totalSavingsPct.toFixed(1)}%
                    </span>
                  </td>

                </tr>
              );
            })}

            <tr
              style={{
                background: '#8b5cf6',
                color: 'white',
                fontWeight: 'bold',
                fontSize: '15px',
              }}
            >
              <td>
                TOTAL ({monthCount} month
                {monthCount !== 1 ? 's' : ''})
              </td>

              <td>
                {totalBaseline.toLocaleString()}
              </td>

              <td>
                {totalActual.toLocaleString()}
              </td>

              <td>
                {totalSavings.toLocaleString()}
              </td>

              <td>
                {totalSavingsPct.toFixed(1)}%
              </td>
            </tr>
          </tbody>
        </table>

        {/* TOTAL SALARY BREAKDOWN */}

        <div
          style={{
            marginTop: '16px',
            padding: '16px',
            background: 'white',
            borderRadius: '8px',
            textAlign: 'center',
          }}
        >
          <div
            style={{
              fontSize: '14px',
              color: '#64748b',
              marginBottom: '6px',
            }}
          >
            Total Salary — {monthCount} month
            {monthCount !== 1 ? 's' : ''}
          </div>

          <div
            style={{
              fontSize: '24px',
              fontWeight: 'bold',
              color: '#64748b',
            }}
          >
            {totalSalary.toLocaleString()} SAR
          </div>

          <div
            style={{
              fontSize: '13px',
              color: '#64748b',
              marginTop: '4px',
            }}
          >
            Maintenance {maintenanceSalaryTotal.toLocaleString()}
            {' + '}
            Development {developmentSalaryTotal.toLocaleString()}
          </div>
        </div>

        {/* TOTAL SAVINGS */}

        <div
          style={{
            marginTop: '16px',
            padding: '16px',
            background: 'white',
            borderRadius: '8px',
            textAlign: 'center',
          }}
        >
          <div
            style={{
              fontSize: '14px',
              color: '#64748b',
              marginBottom: '6px',
            }}
          >
            Total Savings across {monthCount} month
            {monthCount !== 1 ? 's' : ''}
          </div>

          <div
            style={{
              fontSize: '36px',
              fontWeight: 'bold',
              color: '#8b5cf6',
            }}
          >
            {totalSavings.toLocaleString()} SAR
          </div>

          <div
            style={{
              fontSize: '14px',
              color: totalStyle.color,
              marginTop: '4px',
              fontWeight: 'bold',
            }}
          >
            {totalStyle.icon}{' '}
            {totalSavingsPct.toFixed(1)}% saved vs baseline
          </div>
        </div>
      </div>
    </div>
  );
}